# PUBLIC, non-secret lab configuration (committed). Real values such as the domain, zone ID and Roles Anywhere ARNs
# are NOT here: they come from SSM String parameters under /home-lab/config/ (rendered into
# ${APPS_ROOT}/secrets/runtime.env on the Pi), and secrets come from SSM SecureStrings.
# To fork this repo, edit this file, the Terraform workspace variables and the SSM values.
LAN_CIDR=10.0.0.0/24
TAILNET_CIDR=100.64.0.0/10
TZ=Africa/Johannesburg
APPS_ROOT=/apps
PROXY_SUBNET=172.30.0.0/24
# Dedicated network shared by Traefik and authentik-server only (forward auth). Authentik trusts X-Forwarded-* from this subnet only,
# so Homepage and every other container on the proxy network cannot talk to authentik-server:9000 at all (SEC-L8).
AUTHENTIK_AUTH_SUBNET=172.30.1.0/24
# OIDC back-channel (M9): apps that log in with Authentik OIDC (Linkwarden) must reach https://auth.<domain> from inside Docker.
# Traefik joins this network with the alias auth.<domain>, and only the Authentik router also allows this subnet (oidc-allowlist).
OIDC_SUBNET=172.30.2.0/24
TS_HOSTNAME=homelab-pi
# Service identities (F02). NOT 1000: that is the Pi's login user, and a file owned by it is readable by whoever logs in.
# AUTHENTIK_*: the Authentik server and worker (the image default is 1000; compose overrides it with `user:`), which also own
# /apps/authentik/data and the Authentik secret files. AUTHENTIK_PG_*: the PostgreSQL image's own postgres user (owns the data
# directory); it reads postgres-password through the AUTHENTIK_GID group (mode 0440). HOMEPAGE_*: Homepage (M5; read-only root,
# no data directory; it owns only the optional homepage/authentik-token file).
# config/secrets-manifest.tsv and scripts/bootstrap.sh use the same numbers; scripts/test-authentik-config.sh checks they agree.
AUTHENTIK_UID=10002
AUTHENTIK_GID=10002
AUTHENTIK_PG_UID=70
AUTHENTIK_PG_GID=70
HOMEPAGE_UID=10003
HOMEPAGE_GID=10003
# ITTOOLS_*: IT Tools (M7; NGINX serving static files, read-only root, owns no directory).
ITTOOLS_UID=10005
ITTOOLS_GID=10005
# PIHOLE_*: Pi-hole (M8). The image's own default pihole user is 1000 (the Pi's login user), so PIHOLE_UID/PIHOLE_GID override it;
# FTL runs as this uid and owns /apps/pihole/etc-pihole (the entrypoint runs as root only to set up and then drops to it).
PIHOLE_UID=10006
PIHOLE_GID=10006
# Upstream resolvers for Pi-hole (owner decision 2026-11-10: Quad9, which validates DNSSEC and filters known malware domains).
PIHOLE_UPSTREAMS=9.9.9.9;149.112.112.112
# LINKWARDEN_*: Linkwarden and its Meilisearch (M9): own the data and search directories; Linkwarden's PostgreSQL runs as the image's
# postgres user (AUTHENTIK_PG_UID, 70) like Authentik's, on its own data directory.
LINKWARDEN_UID=10007
LINKWARDEN_GID=10007
# TRAEFIK_*: Traefik itself (non-root since SEC-L9); owns /apps/traefik/letsencrypt and the break-glass htpasswd secret file.
TRAEFIK_UID=10004
TRAEFIK_GID=10004
AWS_SSM_REGION=af-south-1
ACME_ENV=prod
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
# prod (M6, via PR): ACME_ENV=prod and ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
# R19 apps (docs/runbooks/r19-apps.md). Free uids 10008 to 10011 (checked: no other use in the repo).
# KOFFAN_*: Koffan shopping list (SQLite in /apps/koffan/data). SPEEDTEST_*: Speedtest Tracker, the ONE root-start container of this
# batch (ADR-018): its s6 init starts as root and drops to PUID/PGID = SPEEDTEST_UID/GID; it owns /apps/speedtest/config.
# N8N_*: n8n (the image's own node user is 1000, overridden). COUCHDB_*: CouchDB for Obsidian LiveSync.
KOFFAN_UID=10008
KOFFAN_GID=10008
SPEEDTEST_UID=10009
SPEEDTEST_GID=10009
N8N_UID=10010
N8N_GID=10010
COUCHDB_UID=10011
COUCHDB_GID=10011
# Speedtest Tracker: the ONE place to change how often it measures (cron, 5 fields, quoted). Every 6 hours at minute 17 is about 4 tests
# a day. Changing it needs a signed release and `sudo scripts/deploy.sh --recreate speedtest`. Empty SPEEDTEST_SERVERS = Ookla picks the
# nearest server; pin one or more Ookla server ids (comma separated) after the first results if wanted.
SPEEDTEST_SCHEDULE="17 */6 * * *"
SPEEDTEST_SERVERS=
# CouchDB for Obsidian LiveSync: the sync user (a per-database admin, not a server admin) and its database. Names only; the passwords are
# SecureStrings (couchdb/sync-password).
COUCHDB_SYNC_USER=livesync
COUCHDB_SYNC_DB=obsidian
