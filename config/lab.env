# PUBLIC, non-secret lab configuration (committed). Real values such as the domain, zone ID and Roles Anywhere ARNs
# are NOT here: they come from SSM String parameters under /home-lab/config/ (rendered into
# ${APPS_ROOT}/secrets/runtime.env on the Pi), and secrets come from SSM SecureStrings.
# To fork this repo, edit this file, the Terraform workspace variables and the SSM values.
LAN_CIDR=10.0.0.0/24
TAILNET_CIDR=100.64.0.0/10
TZ=Africa/Johannesburg
APPS_ROOT=/apps
PROXY_SUBNET=172.30.0.0/24
TS_HOSTNAME=homelab-pi
PUID=1000
PGID=1000
AWS_SSM_REGION=af-south-1
ACME_ENV=staging
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# prod (M6, via PR): ACME_ENV=prod and ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
