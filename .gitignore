# Secrets and local environment - never commit
.env
.env.*
!.env.example
secrets/*
!secrets/README.md
!secrets/.gitkeep
acme*.json
*.pem
*.key
*.csr
adopt-snapshot/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.auto.tfvars
!*.tfvars.example
crash.log
crash.*.log
*.tfplan
*.tfrc.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# NOTE: .terraform.lock.hcl IS committed.

# Logs and runtime data
*.log
homepage/config/logs/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# PKI material (the CA lives outside the repo; certs and CSRs are never committed)
*.crt
*.srl
*.p12
.authentik-test.*/
.homepage-test.*/
.it-tools-test.*/
.pihole-test.*/
.linkwarden-test.*/
.netdata-test.*/
.portainer-test.*/
.homeassistant-test.*/
.traefik-test.*/
.traefik-test-apps.*/

# Owner private denylist for scripts/check-private-denylist.sh (N12): real domain, addresses, e-mails. Never commit.
.gitleaks-private.toml

# scratch directories of the self-tests (scripts/test-*.sh create them inside the repo and remove them on exit)
.*-test.*/
.backup-test-*/
