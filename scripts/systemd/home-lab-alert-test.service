# Installed by scripts/bootstrap.sh (the path below is rewritten to this checkout). SEC-M-2: the monthly heartbeat. It sends a test
# mail; if a month passes without the mail, the subscription or the path is dead (docs/runbooks/alerting.md). A failed publish fails
# this unit (systemctl --failed) and preflight warns when no test has been published for 35 days.
[Unit]
Description=home-lab monthly alert test mail (proves the alert path)
Documentation=file:@REPO_DIR@/docs/runbooks/alerting.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=@REPO_DIR@/scripts/alert.sh test
SyslogIdentifier=home-lab-alert-test
StateDirectory=home-lab
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
