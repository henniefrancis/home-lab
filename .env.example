# Copy to .env (gitignored, mode 600 on the Pi) and fill in. Never commit .env.
# Placeholders only: example.com / you@example.com are not real values.
# Root .env applies to every included compose file (see docs/plan/phase-1-traefik.md, section 5).

# Base domain for every service. Routing is by subdomain: dashboard.${DOMAIN}, traefik.${DOMAIN}, ...
DOMAIN=example.com
PI_LAN_IP=10.0.0.10
LAN_CIDR=10.0.0.0/24
TAILNET_CIDR=100.64.0.0/10
TZ=Africa/Johannesburg

# Optional: ACME account email (Let's Encrypt expiry notices).
ACME_EMAIL=you@example.com
ACME_ENV=staging
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# prod: https://acme-v02.api.letsencrypt.org/directory

APPS_ROOT=/apps
PROXY_SUBNET=172.30.0.0/24
TS_HOSTNAME=homelab-pi
PUID=1000
PGID=1000

# From `terraform output` of the home-lab workspace. Not secret, but account-identifying: keep out of git.
ROUTE53_ZONE_ID=
RA_TRUST_ANCHOR_ARN=
RA_PROFILE_ARN=
RA_ROLE_ARN=
